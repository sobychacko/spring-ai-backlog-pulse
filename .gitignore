# Local secret override — Spring Boot auto-loads ./config/application.yml with higher
# precedence than the packaged one. Keep the real key here; never commit it.
/config/application.yml

# Internal planning doc — not part of the public repo
PLAN.md

# local database dump for deployment seeding
*.dump

# Frontend build output — Vite regenerates it into the jar on every Maven build
# (frontend-maven-plugin at generate-resources); committing it only snapshots stale bundles.
/src/main/resources/static/
